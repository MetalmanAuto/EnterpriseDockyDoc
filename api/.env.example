# ============================================================
# DockyDoc API — Environment Variables
# Copy to .env (local) or set in Render dashboard (staging/production)
#
# REQUIRED in production (app exits on startup if missing):
#   DATABASE_URL, CORS_ORIGINS, SHARE_GRANT_SECRET,
#   ENCRYPTION_KEY, CLERK_SECRET_KEY
# ============================================================

# ─── App ────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development

# Render injects PORT automatically; only set manually for local dev
PORT=8081

# ─── Database ───────────────────────────────────────────────
# Local dev: use docker-compose postgres
# Staging/Production: use separate Neon branches (see DEPLOYMENT.md)
DATABASE_URL="postgresql://dockydoc:dockydoc_secret@localhost:5432/dockydoc_dev?schema=public"

# ─── JWT ────────────────────────────────────────────────────
# MUST be changed before any deployment.
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=7d

# ─── Redis ──────────────────────────────────────────────────
# Optional for initial dev. Required if session caching is enabled.
REDIS_URL=redis://localhost:6379

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local:      http://localhost:8080
# Staging:    https://dockydoc-staging.vercel.app
# Production: https://app.yourdomain.com
CORS_ORIGINS=http://localhost:8080

# ─── Security Secrets ───────────────────────────────────────
# REQUIRED in production. Generate each with: openssl rand -hex 32
SHARE_GRANT_SECRET=replace_with_output_of_openssl_rand_hex_32
ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

# ─── Clerk SSO ──────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
# Use test/dev keys for local dev and staging; live keys for production.
# Leave blank to fall back to x-dev-user-email header (local dev only).
CLERK_SECRET_KEY=sk_test_...

# ─── Storage ────────────────────────────────────────────────
# Default: 'local' (uploads stored in api/uploads/)
# For production, use 's3' with an S3-compatible bucket (AWS, Cloudflare R2, etc.)
# STORAGE_PROVIDER=s3
# S3_BUCKET=dockydoc
# S3_REGION=us-east-1
# S3_ENDPOINT=https://...          # omit for AWS, set for R2/MinIO
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# ─── AI / OCR Providers ─────────────────────────────────────
# All optional — system degrades gracefully to available providers.
# Priority: Azure DI → Mistral OCR → Claude Native
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<name>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=<key>
# MISTRAL_API_KEY=...

# ─── Email / Reminders ──────────────────────────────────────
# All optional — without RESEND_API_KEY reminders are still scheduled and
# marked as sent, but no email goes out (a warning is logged instead).
#
# RESEND_API_KEY=re_...
# EMAIL_FROM="DockyDoc <reminders@yourdomain.com>"   # must be a verified Resend sender
# APP_URL=https://app.yourdomain.com                  # used for links in emails
# ENABLE_SCHEDULER=true                               # set false on extra instances to avoid duplicate sends

# Comma-separated emails allowed to open the platform admin page (/admin)
PLATFORM_ADMIN_EMAILS=

# ─── Payments ───────────────────────────────────────────────
# Razorpay takes rupees (India). Paddle takes dollars everywhere else as
# merchant of record. Either side stays switched off until its keys are set;
# the web then shows a "payments open shortly" note for that currency.
#
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...       # set when creating the webhook in the Razorpay dashboard
#                                   # URL: https://<api host>/api/v1/billing/webhooks/razorpay
# PADDLE_API_KEY=...                # Paddle → Developer tools → Authentication
# PADDLE_CLIENT_TOKEN=...           # client-side token, same page; sent to the browser
# PADDLE_WEBHOOK_SECRET=...         # Paddle → Developer tools → Notifications
#                                   # URL: https://<api host>/api/v1/billing/webhooks/paddle
# PADDLE_ENV=sandbox                # sandbox | production
# On a production server a Razorpay test key or Paddle sandbox stays OFF, so nobody can
# buy a real plan with a test card. Override only for a deliberate test:
# RAZORPAY_ALLOW_TEST=true
# PADDLE_ALLOW_SANDBOX=true

# ─── Alerts ────────────────────────────────────────────────
# ALERT_QUIET_MINUTES=15            # at most one alert email per kind per window
# AI_DAILY_ACTION_ALERT=2000        # alert when a day's AI actions pass this
